{
 "version": 8,
 "name": "RIDEAK Day v0.2",
 "metadata": {
  "rideak:note": "Palette jour inspirée de la planche (carte illustrée lumineuse) sur schéma OpenMapTiles (OpenFreeMap). Données © OpenStreetMap contributors."
 },
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#D9EDB8"
   }
  },
  {
   "id": "landcover-grass",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "grass",
      "farmland",
      "meadow",
      "scrub"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#A9DC7E"
   }
  },
  {
   "id": "landcover-wood",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "wood",
      "forest"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#4FB45C"
   }
  },
  {
   "id": "landuse-residential",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landuse",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "residential",
      "suburb",
      "neighbourhood"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#E8EED3"
   }
  },
  {
   "id": "park",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "park",
   "paint": {
    "fill-color": "#62C657",
    "fill-outline-color": "#3E9F45"
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "paint": {
    "fill-color": "#3FA9F5"
   }
  },
  {
   "id": "waterway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "waterway",
   "paint": {
    "line-color": "#3FA9F5",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     1,
     17,
     5
    ]
   }
  },
  {
   "id": "building",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "building",
   "minzoom": 14,
   "paint": {
    "fill-color": "#F3EAD8",
    "fill-outline-color": "#D8BE96"
   }
  },
  {
   "id": "road-casing",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "primary",
      "secondary",
      "tertiary",
      "trunk",
      "motorway",
      "minor"
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#C9B99A",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     1.6,
     17,
     15
    ]
   }
  },
  {
   "id": "road-minor",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "minor",
      "service",
      "track"
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#FFFDF6",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     0.5,
     17,
     8
    ]
   }
  },
  {
   "id": "road-major",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "primary",
      "secondary",
      "tertiary",
      "trunk",
      "motorway"
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#FFFFFF",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     1.2,
     17,
     12
    ]
   }
  },
  {
   "id": "path",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 14,
   "filter": [
    "all",
    [
     "==",
     [
      "get",
      "class"
     ],
     "path"
    ],
    [
     "!=",
     [
      "get",
      "subclass"
     ],
     "cycleway"
    ]
   ],
   "paint": {
    "line-color": "#B89E74",
    "line-opacity": 0.8,
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     0.4,
     17,
     1.8
    ],
    "line-dasharray": [
     2,
     2
    ]
   }
  },
  {
   "id": "cycleway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 12,
   "filter": [
    "==",
    [
     "get",
     "subclass"
    ],
    "cycleway"
   ],
   "layout": {
    "line-cap": "round"
   },
   "paint": {
    "line-color": "#F2B705",
    "line-opacity": 0.95,
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     0.8,
     17,
     3.5
    ]
   }
  },
  {
   "id": "place-label",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "city",
      "town",
      "village",
      "suburb"
     ]
    ]
   ],
   "layout": {
    "text-field": [
     "get",
     "name"
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     8,
     11,
     14,
     16
    ],
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#122A38",
    "text-halo-color": "#FFFFFF",
    "text-halo-width": 1.8
   }
  },
  {
   "id": "water-label",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "water_name",
   "minzoom": 11,
   "layout": {
    "text-field": [
     "get",
     "name"
    ],
    "text-font": [
     "Noto Sans Italic"
    ],
    "text-size": 12
   },
   "paint": {
    "text-color": "#0B5FA5",
    "text-halo-color": "#FFFFFF",
    "text-halo-width": 1.2
   }
  }
 ]
}