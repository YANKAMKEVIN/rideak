{
 "version": 8,
 "name": "RIDEAK Night v0.1",
 "metadata": {
  "rideak:note": "Palette RIDEAK sur schéma OpenMapTiles (tuiles OpenFreeMap). Données © OpenStreetMap contributors."
 },
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#0E2130"
   }
  },
  {
   "id": "landcover-grass",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "grass",
      "farmland",
      "meadow",
      "scrub"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#163A30"
   }
  },
  {
   "id": "landcover-wood",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "wood",
      "forest"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#1A5040"
   }
  },
  {
   "id": "landuse-residential",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landuse",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "residential",
      "suburb",
      "neighbourhood"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#14283A"
   }
  },
  {
   "id": "park",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "park",
   "paint": {
    "fill-color": "#1F6B47",
    "fill-opacity": 0.85
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "paint": {
    "fill-color": "#1D5FA8"
   }
  },
  {
   "id": "waterway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "waterway",
   "paint": {
    "line-color": "#2E86DE",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     0.8,
     17,
     4
    ]
   }
  },
  {
   "id": "building",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "building",
   "minzoom": 14,
   "paint": {
    "fill-color": "#1E2A38",
    "fill-outline-color": "#2A3D52"
   }
  },
  {
   "id": "road-minor",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "minor",
      "service",
      "track"
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#2C4256",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     0.4,
     17,
     7
    ]
   }
  },
  {
   "id": "road-major",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "primary",
      "secondary",
      "tertiary",
      "trunk",
      "motorway"
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#3E5A73",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     1,
     17,
     12
    ]
   }
  },
  {
   "id": "path",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 14,
   "filter": [
    "all",
    [
     "==",
     [
      "get",
      "class"
     ],
     "path"
    ],
    [
     "!=",
     [
      "get",
      "subclass"
     ],
     "cycleway"
    ]
   ],
   "paint": {
    "line-color": "#3B5268",
    "line-opacity": 0.6,
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     0.3,
     17,
     1.5
    ],
    "line-dasharray": [
     2,
     2
    ]
   }
  },
  {
   "id": "cycleway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "minzoom": 12,
   "filter": [
    "==",
    [
     "get",
     "subclass"
    ],
    "cycleway"
   ],
   "layout": {
    "line-cap": "round"
   },
   "paint": {
    "line-color": "#FFD43B",
    "line-opacity": 0.9,
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     0.8,
     17,
     3.5
    ]
   }
  },
  {
   "id": "place-label",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "city",
      "town",
      "village",
      "suburb"
     ]
    ]
   ],
   "layout": {
    "text-field": [
     "get",
     "name"
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     8,
     11,
     14,
     16
    ],
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#F7F4EA",
    "text-halo-color": "#071521",
    "text-halo-width": 1.6
   }
  },
  {
   "id": "water-label",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "water_name",
   "minzoom": 11,
   "layout": {
    "text-field": [
     "get",
     "name"
    ],
    "text-font": [
     "Noto Sans Italic"
    ],
    "text-size": 12
   },
   "paint": {
    "text-color": "#9CC9F5",
    "text-halo-color": "#071521",
    "text-halo-width": 1.2
   }
  }
 ]
}